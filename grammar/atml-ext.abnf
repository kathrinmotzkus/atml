;; ATML Extension Rules -- Mixed Quantities (Entwurf 2)
;; Rein additiv zu toml-1.1.0.abnf: nur "=/"-Erweiterungen und neue atml-*-Regeln.

val =/ atml-quantity

;; Basis: ausschliesslich dezimal (Integer oder numerischer Float).
;; Niemals hex/oct/bin (Prefix-Ausschluss), niemals inf/nan (kein special-float).
atml-quantity  = atml-zero atml-zero-unit
atml-quantity =/ atml-signed-zero atml-unit
atml-quantity =/ atml-nonzero-dec atml-unit
atml-quantity =/ atml-float-num atml-unit

atml-zero        = %x30                                    ; blankes "0"
atml-signed-zero = ( minus / plus ) %x30                   ; "+0" / "-0" (kollisionsfrei)
atml-nonzero-dec = [ minus / plus ] digit1-9 *( DIGIT / underscore DIGIT )
atml-float-num   = float-int-part ( exp / frac [ exp ] )   ; 1.5 / 0.5 / 1e3, ohne inf/nan

;; Einheit: nur Buchstaben (ms, s, KiB, MiB, GiB, Hz, px, bar, ohm, ...)
atml-unit = 1*ALPHA

;; Einheit nach blankem "0":
;; b/o sind unkritisch (bin/oct verlangen Ziffern). Nur kleines "x" kollidiert
;; mit Hex, und zwar genau dann, wenn ALLE Folgezeichen Hex-Buchstaben sind.
;; Positiv kodiert: nach "x" muss irgendwo ein Nicht-Hex-Buchstabe folgen.
atml-zero-unit  = atml-alpha-no-x *ALPHA
atml-zero-unit =/ %x78 *atml-hex-alpha atml-nonhex-alpha *ALPHA

atml-alpha-no-x   = %x41-5A / %x61-77 / %x79-7A   ; A-Z, a-w, y-z
atml-hex-alpha    = %x41-46 / %x61-66             ; A-F, a-f
atml-nonhex-alpha = %x47-5A / %x67-7A             ; G-Z, g-z

;; -----------------------------------------------------------------
;; Bare Path References (Entwurf 1)
;; Mindestens zwei Segmente; jedes Segment beginnt mit Buchstabe oder
;; Unterstrich. Damit bleiben true/false/inf/nan (einteilig) und
;; 3.14159 (Ziffern-Segmente) eindeutig Standard-TOML-Werte.
;; Kein Whitespace um die Punkte (strenger als TOML-Keys, bewusst).

val =/ atml-path-ref

atml-path-ref = atml-ref-seg 1*( %x2E atml-ref-seg )   ; seg "." seg ...
atml-ref-seg  = ( ALPHA / underscore ) *( ALPHA / DIGIT / underscore / minus )

;; -----------------------------------------------------------------
;; Table Inheritance (Entwurf 1)
;; [child : parent]  bzw.  [child : parent1, parent2, ...]
;; Child und Eltern nutzen die normale TOML-key-Regel (bare/quoted/dotted).
;; Kollisionsfrei: ein Doppelpunkt ausserhalb von Quotes ist in
;; Standard-TOML-Headern unmoeglich.
;; Vorerst nur fuer Standard-Tabellen; [[c : a]] bleibt reserviert.

table =/ atml-inherit-table

atml-inherit-table = std-table-open key ws %x3A ws key
                     *( ws %x2C ws key ) std-table-close

;; -----------------------------------------------------------------
;; Type-Safe Enums (Entwurf 1)
;; Mehrstufig: Typ::Variante oder net::Mode::Active (>= 2 Segmente).
;; Segmente folgen Rust-Ident-Konventionen: Start mit Buchstabe oder
;; Unterstrich, danach Buchstaben/Ziffern/Unterstrich (kein Bindestrich).
;; Kollisionsfrei: "::" existiert in keinem Standard-TOML-Wert, und
;; Local Time (07:32) nutzt nur einfache Doppelpunkte nach Ziffern.

val =/ atml-enum

atml-enum     = atml-enum-seg 1*( %x3A.3A atml-enum-seg )   ; seg "::" seg ...
atml-enum-seg = ( ALPHA / underscore ) *( ALPHA / DIGIT / underscore )
