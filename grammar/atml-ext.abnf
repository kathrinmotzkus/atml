;; ATML Extension Rules -- Mixed Quantities
;; Purely additive to toml-1.1.0.abnf: only "=/" extensions and new atml-* rules.

val =/ atml-quantity

;; Base: strictly decimal (integer or numeric float).
;; Never hex/oct/bin (prefix exclusion), never inf/nan (no special-float).
atml-quantity  = atml-zero atml-zero-unit [ atml-super ]
atml-quantity =/ atml-signed-zero atml-unit [ atml-super ]
atml-quantity =/ atml-nonzero-dec atml-unit [ atml-super ]
atml-quantity =/ atml-float-num atml-unit [ atml-super ]

atml-zero        = %x30                                    ; bare "0"
atml-signed-zero = ( minus / plus ) %x30                   ; "+0" / "-0" (collision-free)
atml-nonzero-dec = [ minus / plus ] digit1-9 *( DIGIT / underscore DIGIT )
atml-float-num   = float-int-part ( exp / frac [ exp ] )   ; 1.5 / 0.5 / 1e3, no inf/nan

;; Unit: letters, optionally followed by an exponent (m^2, m^3, s^-1; or unicode).
atml-unit = 1*ALPHA [ atml-exp ]

;; Exponent, in two interchangeable forms (both allowed):
;;   caret:       "^" ["-"] digits    -> m^2, m^3, s^-1
;;   superscript: unicode digits      -> e.g. U+00B2 (squared), U+00B3 (cubed)
;; The caret form keeps digits behind "^", so a bare unit never gains a digit
;; and the hexadecimal collision (0x1F) stays impossible -- no reliance on the
;; precedence rule. Superscripts are non-ASCII and equally collision-free.
atml-exp       = atml-exp-caret / atml-exp-super
atml-exp-caret = %x5E [ %x2D ] 1*DIGIT            ; "^" ["-"] digits
atml-exp-super = [ %x207B ] 1*atml-sup-digit      ; superscript minus then digits
atml-sup-digit = %xB9 / %xB2 / %xB3 / %x2070 / %x2074-2079   ; superscript 0-9

;; Optional super-unit for rates/products: a separator plus a further unit
;; (which may itself carry an exponent, e.g. m/s^2).
;; Separator is "/" (per) or "*" (times), e.g. 1.80EUR/L, 5N*m.
;; Collision-free: neither "/" nor "*" occurs in any TOML value, and the
;; super-unit sits after a valid unit. The set of separators, units, and
;; super-units MAY be constrained by author-defined enums (a semantic layer,
;; not enforced by the grammar).
atml-super = atml-sep 1*ALPHA [ atml-exp ]
atml-sep   = %x2F / %x2A                          ; "/" or "*"

;; Unit after a bare "0":
;; b/o are harmless (bin/oct require digits). Only lowercase "x" collides
;; with hex, and only when ALL following characters are hex letters.
;; Encoded positively: after "x" at least one non-hex letter must follow.
atml-zero-unit  = atml-alpha-no-x *ALPHA [ atml-exp ]
atml-zero-unit =/ %x78 *atml-hex-alpha atml-nonhex-alpha *ALPHA [ atml-exp ]

atml-alpha-no-x   = %x41-5A / %x61-77 / %x79-7A   ; A-Z, a-w, y-z
atml-hex-alpha    = %x41-46 / %x61-66             ; A-F, a-f
atml-nonhex-alpha = %x47-5A / %x67-7A             ; G-Z, g-z

;; -----------------------------------------------------------------
;; Bare Path References
;; At least two segments; each segment starts with a letter or underscore.
;; This keeps true/false/inf/nan (single tokens) and 3.14159 (digit
;; segments) unambiguously standard TOML values.
;; No whitespace around the dots (deliberately stricter than TOML keys).

val =/ atml-path-ref

atml-path-ref = atml-ref-seg 1*( %x2E atml-ref-seg )   ; seg "." seg ...
atml-ref-seg  = ( ALPHA / underscore ) *( ALPHA / DIGIT / underscore / minus )

;; -----------------------------------------------------------------
;; Table Inheritance
;; [child : parent]  or  [child : parent1, parent2, ...]
;; Child and parents use the standard TOML key rule (bare/quoted/dotted).
;; Collision-free: a colon outside quotes is impossible in standard TOML
;; headers.

table =/ atml-inherit-table

atml-inherit-table = std-table-open key ws %x3A ws key
                     *( ws %x2C ws key ) std-table-close

;; -----------------------------------------------------------------
;; Enums
;; An enum is a datatype with a fixed set of predefined choices. A choice
;; is either a bare symbol (an identifier like Active) or an ordinary TOML
;; value (a string, number, boolean, ...). Both may be mixed in one enum.
;;
;; Two definition forms:
;;
;;   Marked (universal):   <enum-name>[] = [ choice, choice, ... ]
;;     The "[]" marker makes the declaration an enum regardless of its
;;     contents. This is the general form and the only one that can carry a
;;     list of purely ordinary values (e.g. ports [110, 111, 143]), since
;;     such a list is indistinguishable from a plain array without a marker.
;;
;;   Markerless (shorthand):   <enum-name> = [ choice, choice, ... ]
;;     Valid ATML too, but only acts as an enum when the list does not parse
;;     as a plain TOML array -- i.e. when it contains at least one bare
;;     symbol. A list of purely ordinary values stays a plain array under
;;     the precedence rule of spec section 4. The grammar below is permissive;
;;     that precedence rule performs the demotion, so it is not encoded here.
;;
;; Usage:
;;   - a symbol is referenced as   <enum-name>::<symbol>   (exactly one "::")
;;   - an ordinary value is used directly (e.g. port = 111)
;;   Namespacing uses ordinary dotted keys: probe.Strategy::Passive,
;;   defined by probe.Strategy[] = [ ... ] or probe.Strategy = [ ... ].
;;
;; Membership -- a used symbol/value must belong to the enum's definition,
;; which must be in scope (declared at a higher position) -- is a binding
;; across distance. It lives in the normative spec text, not in this grammar.

;; Marked declaration is a whole key/value entry (the LHS carries "[]").
keyval =/ atml-enum-decl
atml-enum-decl = key %x5B.5D keyval-sep atml-enum-list

;; Markerless declaration is just a value (an enum list on the RHS).
val =/ atml-enum-list

;; Reference is a value.
val =/ atml-enum-ref

;; A symbol: start with a letter or underscore, then letters/digits/underscore.
atml-enum-symbol = ( ALPHA / underscore ) *( ALPHA / DIGIT / underscore )

;; Reference: TOML key, then "::", then one symbol.
atml-enum-ref = key %x3A.3A atml-enum-symbol

;; A choice is a bare symbol or any ordinary TOML value.
atml-enum-choice = atml-enum-symbol / val

;; The bracketed, comma-separated list of at least one choice.
;; Reuses the TOML array delimiters and inner whitespace/comment handling.
atml-enum-list  = array-open atml-enum-items ws-comment-newline array-close
atml-enum-items = ws-comment-newline atml-enum-choice ws-comment-newline array-sep atml-enum-items
atml-enum-items =/ ws-comment-newline atml-enum-choice ws-comment-newline [ array-sep ]

;; -----------------------------------------------------------------
;; Array-of-Tables Inheritance  (spec decision #13, implemented)
;; [[child : parent]]  or  [[child : p1, p2, ...]]
;; Semantics: appends a NEW element to the array "child" and seeds it with
;; the resolved key/values of its parents (first wins), then the child's own
;; key/values override. Parents must resolve to standard tables (array
;; elements are not name-addressable) -- a semantic, not a grammar, rule.
;; array-table-open/-close already carry ws.

array-table =/ atml-inherit-array

atml-inherit-array = array-table-open key ws %x3A ws key
                     *( ws %x2C ws key ) array-table-close
