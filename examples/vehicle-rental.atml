# Vehicle rental -- ATML concept for enum-classified inheritance.
#
# Demonstrates the proposed [<child> : <table>.<enum>::<member>] form. A
# concrete build inherits the common vehicle properties and simultaneously
# selects one valid member of the corresponding vehicle enum. Fleet entries
# then combine one concrete build with one drive template.
#
# This is a concept document for a proposed ATML extension. Current released
# parsers do not yet accept enum-classified inheritance parents.

# --------------------------------------------------------------------------
# Enums (declared once, at the top).
# --------------------------------------------------------------------------
DriveType[]          = [Petrol, Diesel, Electric, NaturalGas, Hydrogen, Muscle]
Location[]           = [Berlin, Hamburg, Munich, Cologne]
Status[]             = [available, rented, maintenance, reserved]
EnvironmentalClass[] = [A, B, C, D]
LocalEmissions[]     = [zero, combustion]
LicenceClass[]       = [AM, A1, A2, A, B, C1, C, CE, D]

# --------------------------------------------------------------------------
# Base: every rentable vehicle. Rental-intrinsic values.
# --------------------------------------------------------------------------
[vehicle]
truck[]          = [light, medium, heavy]
car[]            = [small, compact, estate, van]
twowheeler[]     = [motorized, ebike, bicycle]
currency          = "EUR"
min_rental_period = 1d
status            = Status::available   # default; a fleet entry may override

# --------------------------------------------------------------------------
# Build axis. Every concrete build inherits vehicle and selects one valid
# member of the corresponding enum declared in [vehicle].
# --------------------------------------------------------------------------
[truck.light : vehicle.truck::light]
wheels        = 4
seats         = 2
licence_class = LicenceClass::B
cargo_volume  = 20m^3
deposit       = 500EUR
base_rate     = 89EUR

[truck.medium : vehicle.truck::medium]
wheels        = 4
seats         = 3
licence_class = LicenceClass::C1
cargo_volume  = 40m^3
deposit       = 1000EUR
base_rate     = 149EUR

[truck.heavy : vehicle.truck::heavy]
wheels        = 6
seats         = 2
licence_class = LicenceClass::CE
cargo_volume  = 90m^3
deposit       = 2500EUR
base_rate     = 299EUR

[car.small : vehicle.car::small]
wheels        = 4
seats         = 4
licence_class = LicenceClass::B
cargo_volume  = 0.3m^3
deposit       = 200EUR
base_rate     = 39EUR

[car.compact : vehicle.car::compact]
wheels        = 4
seats         = 5
licence_class = LicenceClass::B
cargo_volume  = 0.5m^3
deposit       = 250EUR
base_rate     = 49EUR

[car.estate : vehicle.car::estate]
wheels        = 4
seats         = 5
licence_class = LicenceClass::B
cargo_volume  = 1.5m^3
deposit       = 300EUR
base_rate     = 59EUR

[car.van : vehicle.car::van]
wheels        = 4
seats         = 7
licence_class = LicenceClass::B
cargo_volume  = 4m^3
deposit       = 400EUR
base_rate     = 79EUR

[twowheeler.motorized : vehicle.twowheeler::motorized]
wheels        = 2
seats         = 2
licence_class = LicenceClass::A
cargo_volume  = 0m^3
deposit       = 300EUR
base_rate     = 45EUR

[twowheeler.ebike : vehicle.twowheeler::ebike]
wheels       = 2
seats        = 1
cargo_volume = 0m^3
deposit      = 150EUR
base_rate    = 25EUR

[twowheeler.bicycle : vehicle.twowheeler::bicycle]
wheels       = 2
seats        = 1
cargo_volume = 0m^3
deposit      = 80EUR
base_rate    = 15EUR

# --------------------------------------------------------------------------
# Drive axis (vehicle-independent). Standalone templates (not vehicles).
# --------------------------------------------------------------------------
[drive.petrol]
drive               = DriveType::Petrol
energy_source       = "petrol"
environmental_class = EnvironmentalClass::D
local_emissions     = LocalEmissions::combustion
rate_modifier       = 1.00
energy_cost         = 1.80EUR/L

[drive.diesel]
drive               = DriveType::Diesel
energy_source       = "diesel"
environmental_class = EnvironmentalClass::D
local_emissions     = LocalEmissions::combustion
rate_modifier       = 1.00
energy_cost         = 1.70EUR/L

[drive.electric]
drive               = DriveType::Electric
energy_source       = "electricity"
environmental_class = EnvironmentalClass::A
local_emissions     = LocalEmissions::zero
rate_modifier       = 1.15
energy_cost         = 0.40EUR/kWh

[drive.naturalgas]
drive               = DriveType::NaturalGas
energy_source       = "natural_gas"
environmental_class = EnvironmentalClass::C
local_emissions     = LocalEmissions::combustion
rate_modifier       = 0.95
energy_cost         = 1.20EUR/kg

[drive.hydrogen]
drive               = DriveType::Hydrogen
energy_source       = "hydrogen"
environmental_class = EnvironmentalClass::B
local_emissions     = LocalEmissions::zero
rate_modifier       = 1.20
energy_cost         = 12.00EUR/kg

[drive.muscle]
drive               = DriveType::Muscle
energy_source       = "human"
environmental_class = EnvironmentalClass::A
local_emissions     = LocalEmissions::zero
rate_modifier       = 0.50
# no energy_cost: muscle has no energy carrier

# --------------------------------------------------------------------------
# The concrete fleet: array-of-tables, each inheriting one build + one drive
# (build first, drive second). Only per-vehicle values appear here; every
# build and drive value comes from the templates above via inheritance.
# --------------------------------------------------------------------------

[[fleet : car.compact, drive.electric]]
id          = "CE-01"
location    = Location::Berlin
range       = 350km
charge_time = 30min

[[fleet : car.compact, drive.electric]]
id          = "CE-02"
location    = Location::Hamburg
status      = Status::rented
range       = 350km
charge_time = 30min

[[fleet : car.compact, drive.electric]]
id          = "CE-03"
location    = Location::Munich
range       = 350km
charge_time = 30min

[[fleet : car.compact, drive.electric]]
id          = "CE-04"
location    = Location::Cologne
range       = 350km
charge_time = 30min

[[fleet : car.compact, drive.electric]]
